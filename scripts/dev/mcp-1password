#!/bin/sh
set -eu
for candidate in "${WORKSHOP_1PASSWORD_MCP_BIN:-}" "$(command -v 1password-mcp || true)" /opt/homebrew/bin/1password-mcp /usr/local/bin/1password-mcp; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        if [ "${1:-}" = --check ]; then printf '%s\n' '1Password MCP executable found'; exit 0; fi
        exec "$candidate" "$@"
    fi
done
echo 'Install the 1Password MCP server or set WORKSHOP_1PASSWORD_MCP_BIN to its executable.' >&2
exit 1
